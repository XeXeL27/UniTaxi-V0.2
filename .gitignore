# Secretos locales: perfiles de Spring y variables de Docker (solo se suben las plantillas .example)
backend/src/main/resources/application-*.properties
!backend/src/main/resources/application-*.properties.example
# local.properties lo genera el IDE con rutas absolutas de esta maquina (sdk.dir, etc).
# No aplica a la regla de arriba porque vive fuera de src/main/resources.
local.properties
.env
*.env
!.env.example

# Backend (Gradle)
backend/build/
backend/.gradle/
backend/bin/
backend/out/

# IDEs y herramientas locales
.idea/
*.iml
.vscode/
.github/modernize/
.claude/settings.local.json

# Flutter
**/.dart_tool/
**/build/
**/.flutter-plugins
**/.flutter-plugins-dependencies

# Node
**/node_modules/

# Sistema
.DS_Store
*.log

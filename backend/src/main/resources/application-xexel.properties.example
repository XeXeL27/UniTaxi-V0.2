# ============================================================
#  TaxiUAP - Backend
#  application-xexel.properties - Entorno local: Xexel
#  Plantilla: copiar a application-<perfil>.properties y completar los valores
# ============================================================

# --- Servidor ----------------------------------------------
server.port=8080

# --- Datasource --------------------------------------------
spring.datasource.url=jdbc:postgresql://localhost:5436/taxiuap
spring.datasource.username=postgres
spring.datasource.password=<cambiar>
spring.datasource.driver-class-name=org.postgresql.Driver

# --- JPA / Hibernate (solo desarrollo) ---------------------
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# --- JWT ---------------------------------------------------
jwt.secret=<cambiar>

# --- CORS (panel admin Vite) -------------------------------
cors.origenes=http://localhost:5173,http://127.0.0.1:5173

# --- Administrador inicial ---------------------------------
admin.inicial.correo=admin@taxiuap.bo
admin.inicial.password=<cambiar>

# --- Consola en color --------------------------------------
spring.output.ansi.enabled=ALWAYS

# --- Datos de prueba ----------------------------------------
taxiuap.seed.habilitado=true

# --- Google OAuth2 (login con Google) -----------------------
google.client-id=${GOOGLE_CLIENT_ID:}
google.client-secret=${GOOGLE_CLIENT_SECRET:}
google.redirect-uri=${GOOGLE_REDIRECT_URI:http://localhost:8080/api/auth/google/callback}

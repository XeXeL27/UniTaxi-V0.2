# ============================================================
#  TaxiUAP - Backend
#  application-xexel.properties - Entorno local: Xexel
#  Plantilla: copiar a application-<perfil>.properties y completar los valores
# ============================================================

# --- Servidor ----------------------------------------------
server.port=5557

# --- Datasource --------------------------------------------
spring.datasource.url=jdbc:postgresql://localhost:5436/taxiuap
spring.datasource.username=postgres
spring.datasource.password=<cambiar>
spring.datasource.driver-class-name=org.postgresql.Driver

# --- JPA / Hibernate (solo desarrollo) ---------------------
# show-sql imprimia cada consulta en la consola y tapaba los errores. Para ver el SQL: LOG_SQL=DEBUG
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true

# --- JWT ---------------------------------------------------
jwt.secret=<cambiar>

# --- CORS (panel admin Vite) -------------------------------
cors.origenes=https://uni-taxi.uap.edu.bo,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://localhost:5175

# --- Administrador inicial ---------------------------------
admin.inicial.correo=admin@taxiuap.bo
admin.inicial.password=<cambiar>

# --- Consola en color --------------------------------------
spring.output.ansi.enabled=ALWAYS

# --- Datos de prueba ----------------------------------------
taxiuap.seed.habilitado=true

# Google OAuth2 (login con Google); los valores vienen del .env de la raiz (bootRun lo carga)
google.client-id=${GOOGLE_CLIENT_ID:}
google.client-secret=${GOOGLE_CLIENT_SECRET:}
google.redirect-uri=${GOOGLE_REDIRECT_URI:http://localhost:5557/api/auth/google/callback}

# --- Correo saliente (Gmail / Google Workspace: contrasena de aplicacion) ---
spring.mail.username=cuenta@dominio
spring.mail.password=CAMBIAR

# Direccion con que se abre la app desde el enlace de los correos
taxiuap.url-publica=https://uni-taxi.uap.edu.bo

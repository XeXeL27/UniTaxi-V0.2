# Copiar como .env y completar. El archivo .env no se sube al repositorio.
# Debe coincidir con spring.datasource.password del perfil xexel.
TAXIUAP_DB_PASSWORD=<cambiar>

# Login con Google (Google Cloud Console -> API y servicios -> Credenciales -> OAuth 2.0).
# bootRun (y ./iniciar.sh) cargan este archivo; Spring las lee como google.client-id, etc.
GOOGLE_CLIENT_ID=<cambiar>
GOOGLE_CLIENT_SECRET=<cambiar>
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Ruta al JSON de la cuenta de servicio de Firebase (notificaciones push); vacio = sin push
FIREBASE_CREDENCIALES=

# Lectura de carnet y licencia (Google AI Studio). Opcional: sin ella la app lee con ML Kit
GEMINI_API_KEY=<cambiar>

# Firma del JWT
JWT_SECRET=<cambiar>

# Precio de referencia del servicio DELIVERY. Sin estos valores el precio de una entrega sale
# Bs 0,00. Son los mismos de la tarifa MOTO (4,00 base, 1,80 por km, 0,20 por minuto).
DELIVERY_TARIFA_BASE=4.00
DELIVERY_PRECIO_KM=1.80
DELIVERY_PRECIO_MINUTO=0.20
DELIVERY_COMISION_PORCENTAJE=0.00

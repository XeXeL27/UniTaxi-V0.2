# Copiar como .env y completar. El archivo .env no se sube al repositorio.
# Debe coincidir con spring.datasource.password del perfil xexel.
TAXIUAP_DB_PASSWORD=<cambiar>

# Login con Google (Google Cloud Console -> API y servicios -> Credenciales -> OAuth 2.0).
# bootRun (y ./iniciar.sh) cargan este archivo; Spring las lee como google.client-id, etc.
GOOGLE_CLIENT_ID=<cambiar>
GOOGLE_CLIENT_SECRET=<cambiar>
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

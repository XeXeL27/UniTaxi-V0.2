# Copiar como .env y completar. El archivo .env no se sube al repositorio.
# Contrasena de la BD (la usan docker compose y el backend).
TAXIUAP_DB_PASSWORD=<cambiar>
# Conexion a la BD (opcional; vacio = localhost:5436). El perfil de la maquina puede definirla tambien.
DB_URL=
DB_USUARIO=

# Servidor: puerto interno (el proxy con el certificado reenvia a este puerto) y direccion publica
# (enlaces de los correos). Produccion: https://uni-taxi.uap.edu.bo
SERVER_PORT=5557
URL_PUBLICA=https://uni-taxi.uap.edu.bo
CORS_ORIGENES=https://uni-taxi.uap.edu.bo,http://uni-taxi.uap.edu.bo

# Administrador inicial (se crea al arrancar si no existe)
ADMIN_CORREO=<cambiar>
ADMIN_PASSWORD=<cambiar>

# Login con Google (Google Cloud Console -> API y servicios -> Credenciales -> OAuth 2.0).
# bootRun (y ./iniciar.sh) cargan este archivo; Spring las lee como google.client-id, etc.
GOOGLE_CLIENT_ID=<cambiar>
GOOGLE_CLIENT_SECRET=<cambiar>
GOOGLE_REDIRECT_URI=https://uni-taxi.uap.edu.bo/api/auth/google/callback

# Ruta al JSON de la cuenta de servicio de Firebase (notificaciones push); vacio = sin push
FIREBASE_CREDENCIALES=

# Lectura de carnet, licencia y foto con el carnet: primero Claude (console.anthropic.com) y, si no
# responde, Gemini (Google AI Studio). Opcionales: sin ninguna la app lee con ML Kit
ANTHROPIC_API_KEY=<cambiar>
# Modelo de Claude (por defecto claude-sonnet-5-5; claude-haiku-4-5 es mas barato pero lee peor)
CLAUDE_MODELO=claude-sonnet-5-5
GEMINI_API_KEY=<cambiar>

# Firma del JWT
JWT_SECRET=<cambiar>

# Precio de referencia del servicio DELIVERY. Sin estos valores el precio de una entrega sale
# Bs 0,00. Son los mismos de la tarifa MOTO (4,00 base, 1,80 por km, 0,20 por minuto).
DELIVERY_TARIFA_BASE=4.00
DELIVERY_PRECIO_KM=1.80
DELIVERY_PRECIO_MINUTO=0.20
DELIVERY_COMISION_PORCENTAJE=0.00

# SIGSE de la UAP: registro y verificacion de estudiantes por RU. Solo en el servidor, nunca en la app.
SIGSE_URL=<cambiar>
SIGSE_API_KEY=<cambiar>

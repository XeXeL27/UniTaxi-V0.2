<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Notificacion de solicitud nueva al conductor (Android 13 o superior) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Servicio en primer plano mientras el pasajero busca taxi o esta en viaje: Android congela las
         apps minimizadas y sin esto los avisos del viaje (sonido y notificacion) no llegarian -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- El conductor conectado sigue enviando su GPS con la app minimizada -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <!-- Guardar en la galeria la imagen del QR del conductor (paquete gal; Android 9 o anterior) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>
    <application
        android:label="UNITAXI"
        android:usesCleartextTraffic="true"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Notificacion fija mientras hay viaje o el conductor esta conectado (Notificador.seguirViaje).
             Servicio propio: el de flutter_local_notifications cerraba la app si Android rechazaba el
             tipo ubicacion (sin permiso o desde segundo plano, Android 14+) -->
        <service
            android:name=".ServicioSeguimiento"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="dataSync|location"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Enlace "Iniciar sesion" de los correos (/ingresar del backend): abre la app -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="taxiuap" android:host="ingresar"/>
            </intent-filter>
            <!-- El enlace solo abre la app; Flutter no debe tratarlo como una ruta de navegacion -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false"/>
        </activity>
        <!-- "Abrir con UNITAXI": una ubicacion compartida por WhatsApp, Telegram, Messenger o SMS.
             Android pregunta con que app abrirla y UNITAXI aparece junto a Google Maps, Waze, etc.
             AbrirUbicacionActivity no se ve: pasa el enlace a MainActivity y se cierra -->
        <activity
            android:name=".AbrirUbicacionActivity"
            android:exported="true"
            android:label="UNITAXI"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <!-- geo:-11.02,-68.76 y geo:0,0?q=-11.02,-68.76(Lugar): lo que abren WhatsApp y Telegram -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="geo"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="google.navigation"/>
            </intent-filter>
            <!-- Enlaces de ubicacion de Google Maps (Messenger y otros). Android 12 o superior los abre
                 directo en Google Maps; hasta Android 11 pregunta. No incluye /maps/dir (el boton
                 "Abrir en Maps" del conductor sigue yendo directo a Google Maps) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:host="maps.app.goo.gl"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:host="goo.gl"/>
                <data android:pathPrefix="/maps"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="http"/>
                <data android:scheme="https"/>
                <data android:host="maps.google.com"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:host="www.google.com"/>
                <data android:host="google.com"/>
                <data android:pathPrefix="/maps/place"/>
                <data android:pathPrefix="/maps/search"/>
                <data android:pathPrefix="/maps/@"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="mailto"/>
        </intent>
        <!-- Llamar al conductor, a quien viaja o al 110 desde el panel del viaje (Android 11+). -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
